# PostgreSQL connection strings. Use a pooled runtime URL and a direct migration URL when your host provides both.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Provision one administrator out of band. Generate the password hash with `npm run admin:hash-password`.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Use independent random secrets (at least 32 characters each).
IDEMPOTENCY_SECRET=
RATE_LIMIT_HASH_SECRET=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
